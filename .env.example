ECA_DB_HOST=127.0.0.1
ECA_DB_NAME=eca_local
ECA_DB_USER=root
ECA_DB_PASS=
ECA_LOCAL_ADMIN_PASSWORD=

# Local-only portal override (never used on eca.co.sz). Falls back to ECA_LOCAL_ADMIN_PASSWORD.
# Optional: ECA_LOCAL_MEMBER_PASSWORD=  ECA_LOCAL_CPD_PASSWORD=
ECA_LOCAL_PORTAL_PASSWORD=

# Membership / CPD database. Local setup creates eca_portal_local.
ECA_PORTAL_DB_HOST=127.0.0.1
ECA_PORTAL_DB_NAME=eca_portal_local
ECA_PORTAL_DB_USER=root
ECA_PORTAL_DB_PASS=

# Required to actually deliver mail (membership approval welcome, application received, etc.).
# Leave blank locally: the send path still runs and writes _private/mail-log/*.json
ECA_SMTP_HOST=
ECA_SMTP_USER=
ECA_SMTP_PASS=
ECA_SMTP_PORT=587
# Optional From address. Defaults to ECA_SMTP_USER or info@eca.co.sz
# ECA_SMTP_FROM=info@eca.co.sz

# local | live_readonly | production
# live_readonly reads production and disables writes.
# production enables fail-closed gates (preview SSO off, CSRF token-only, MoMo live opt-in).
# Leave the LIVE_DB values empty until you create a SELECT-only MySQL user.
APP_ENV=local
LIVE_DB_HOST=
LIVE_DB_PORT=3306
LIVE_DB_NAME=
LIVE_DB_USER=
LIVE_DB_PASSWORD=

# Production cookie / TLS (set on host only; do not force HSTS locally)
# ECA_COOKIE_SECURE=1

# Portal preview / mock SSO (production: leave unset or 0 — fail closed)
# ECA_ALLOW_PORTAL_PREVIEW=0

# Legacy training registration path (production: leave unset unless ECA approves)
# ECA_ALLOW_LEGACY_TRAINING_REG=0

# MoMo (never commit real tokens). Default mode is sandbox / blocked live.
# ECA_MOMO_API_TOKEN=
# ECA_MOMO_MODE=sandbox
# ECA_MOMO_ALLOW_LIVE=0
# ECA_MOMO_REMOTE_URL=
